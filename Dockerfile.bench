# Rory as a Veris Bench image candidate.
#
# The bench runs this container directly: it injects the twins' base URLs
# (STRIPE_API_BASE, FINERACT_API_BASE) plus the candidate's own env, polls
# GET /health on :8008 for readiness, and opens the voice_ws session at
# ws://<host>:8008/voice.
#
#   docker build --platform linux/amd64 -f Dockerfile.bench -t rory-bench .
#
# This image carries the Pipecat and Gemini Live transports; RORY_AGENT_APP
# picks which ASGI app boots.

FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /agent

COPY pyproject.toml uv.lock README.md ./
COPY pipecat/pyproject.toml pipecat/README.md ./pipecat/
COPY gemini-live/pyproject.toml gemini-live/README.md ./gemini-live/
COPY rory_tools ./rory_tools
COPY pipecat/rory_pipecat ./pipecat/rory_pipecat
COPY gemini-live/rory_gemini_live ./gemini-live/rory_gemini_live
# Only the two transports this image ships. --all-packages would need every
# workspace member's sources copied in (uv builds them with --no-editable).
RUN uv sync --frozen --no-dev --no-editable --package rory-pipecat \
 && uv sync --frozen --no-dev --no-editable --inexact --package rory-gemini-live
RUN uv run --no-sync python -c "import rory_pipecat.web, rory_gemini_live.web; from rory_tools.prompt import load_agent_prompt; assert load_agent_prompt()"

EXPOSE 8008
CMD ["sh", "-c", "exec uv run --no-sync uvicorn \"${RORY_AGENT_APP:?RORY_AGENT_APP not set}\" --host 0.0.0.0 --port 8008"]
